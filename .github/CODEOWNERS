# CODEOWNERS - 代码所有权配置
# 参考: https://docs.github.com/en/repositories/managing-your-repositorys-settings-and-features/customizing-your-repository/about-code-owners
#
# 格式: <目录或文件模式> <GitHub用户名或团队名>
# 一个文件可以有多个所有者，用空格分隔
# 顺序很重要：最后匹配的规则优先级最高

# ==================== 全局默认所有者 ====================
# 默认情况下所有文件的所有者
*                           @owner

# ==================== 安全相关文件 ====================
# 安全策略和配置
/SECURITY.md                @security-team
/.github/security-insights.yml @security-team
/.github/dependabot.yml     @security-team @owner

# GitHub Actions 工作流
/.github/workflows/         @security-team @devops-team
/.github/workflows/codeql*.yml       @security-team
/.github/workflows/semgrep.yml       @security-team
/.github/workflows/trivy*.yml        @security-team
/.github/workflows/gitleaks.yml      @security-team
/.github/workflows/trufflehog.yml    @security-team
/.github/workflows/osv-scanner.yml   @security-team
/.github/workflows/snyk.yml          @security-team
/.github/workflows/devskim.yml       @security-team

# ==================== CI/CD 配置 ====================
/.github/workflows/         @devops-team @security-team
/Dockerfile                 @devops-team
/docker-compose*.yml        @devops-team
/Makefile                   @devops-team

# ==================== Rust 代码 ====================
# Rust 源码和配置
*.rs                        @rust-team
/Cargo.toml                 @rust-team
/Cargo.lock                 @rust-team
/crates/                    @rust-team
/src/                       @rust-team

# Rust CI 工作流
/.github/workflows/cargo-*.yml  @rust-team @security-team
/.github/workflows/clippy.yml   @rust-team
/.github/workflows/rustfmt.yml  @rust-team
/.github/workflows/miri.yml     @rust-team

# ==================== Python 代码 ====================
# Python 源码和配置
*.py                        @python-team
/pyproject.toml             @python-team
/setup.py                   @python-team
/setup.cfg                  @python-team
/requirements*.txt          @python-team
/src/                       @python-team
/tests/                     @python-team

# Python CI 工作流
/.github/workflows/bandit.yml     @python-team @security-team
/.github/workflows/pip-audit.yml  @python-team @security-team
/.github/workflows/safety.yml     @python-team @security-team
/.github/workflows/ruff.yml       @python-team
/.github/workflows/mypy.yml       @python-team
/.github/workflows/pylint.yml     @python-team
/.github/workflows/vulture.yml    @python-team

# ==================== Go 代码 ====================
# Go 源码和配置
*.go                        @go-team
/go.mod                     @go-team
/go.sum                     @go-team
/cmd/                       @go-team
/pkg/                       @go-team
/internal/                  @go-team

# Go CI 工作流
/.github/workflows/gosec.yml          @go-team @security-team
/.github/workflows/staticcheck.yml    @go-team
/.github/workflows/govulncheck.yml    @go-team @security-team
/.github/workflows/golangci-lint.yml  @go-team
/.github/workflows/go-fuzz.yml        @go-team @security-team

# ==================== 文档 ====================
*.md                        @docs-team @owner
/docs/                      @docs-team
/README.md                  @owner @docs-team
/CHANGELOG.md               @owner @docs-team

# ==================== 配置文件 ====================
*.yml                       @devops-team
*.yaml                      @devops-team
*.json                      @devops-team
*.toml                      @devops-team
.env*                       @security-team @owner

# ==================== 测试文件 ====================
/tests/                     @owner
/test/                      @owner
*_test.go                   @go-team
*_test.py                   @python-team

# ==================== 其他 ====================
/.gitignore                 @owner
/LICENSE                    @owner @legal-team
/.github/CODEOWNERS         @owner
